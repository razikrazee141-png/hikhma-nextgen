# Hikhma Islamic School - Environment Variables
# Copy this file to .env and provide your Supabase project credentials.

# Your Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous / Publishable Key (safe to use in frontend with RLS enabled)
# NEVER expose the service_role key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Admin Portal Master Credentials (optional override)
VITE_ADMIN_USERNAME=your-admin-username
VITE_ADMIN_PASSWORD=your-secure-admin-password
